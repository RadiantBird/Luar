class Lua is
    private is
        Year = 0
        function explode()
            print("Boom!!")
        end
    end

    public is
        static function new(year: number)
            self.Year = year
        end

        function greet()
            print(`Hello from {self.Year}!`)
        end

        function operator==(AnotherRock: Lua)
            return false
        end
    end
end

local L = Lua.new(1993)
L.greet()
