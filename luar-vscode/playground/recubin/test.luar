import type RCBN

function main()
    local name = "Cube"
    if cube := Instance.new(name) then
        cube.Name = "Cat"
    else
        print(`failed to make the Instance: {name}!`)
    end

    local v = Vector3.new(1, 2, 3)
    v.set(4, 5, 6)
    print(v)
    local v2 = v * 2
    print(v2)
end
main()