{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luar",
  "scopeName": "source.luar",
  "patterns": [
    { "include": "#block-comment" },
    { "include": "#line-comment" },
    { "include": "#template-string" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#include-macro" },
    { "include": "#type-annotation" },
    { "include": "#const-decl" },
    { "include": "#import-decl" },
    { "include": "#type-alias" },
    { "include": "#template-header" },
    { "include": "#declare-decl" },
    { "include": "#binding-operator" },
    { "include": "#function-decl" },
    { "include": "#friend-decl" },
    { "include": "#class-decl" },
    { "include": "#label" },
    { "include": "#cast-operator" },
    { "include": "#type-operators" },
    { "include": "#builtin" },
    { "include": "#keyword" },
    { "include": "#constant" }
  ],
  "repository": {
    "block-comment": {
      "name": "comment.block.luar",
      "begin": "--\\[\\[",
      "end": "\\]\\]"
    },
    "line-comment": {
      "name": "comment.line.double-dash.luar",
      "match": "--.*$"
    },
    "template-string": {
      "name": "string.quoted.other.luar",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "meta.template.expression.luar",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.luar" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.template-expression.end.luar" } },
          "patterns": [ { "include": "#template-expression" } ]
        },
        { "name": "constant.character.escape.luar", "match": "\\\\." }
      ]
    },
    "string": {
      "patterns": [
        { "name": "string.quoted.double.luar", "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"" },
        { "name": "string.quoted.single.luar", "match": "'(?:[^'\\\\\\n]|\\\\.)*'" }
      ]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.luar", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.luar", "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b" }
      ]
    },
    "const-decl": {
      "comment": "contextual const declaration",
      "match": "(^[ \\t]*|[;\\n][ \\t]*)(const)\\b",
      "captures": {
        "2": { "name": "storage.modifier.const.luar" }
      }
    },
    "include-macro": {
      "comment": "source include declaration macro",
      "match": "(!include)\\s*(\\()\\s*(\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*')\\s*(\\))",
      "captures": {
        "1": { "name": "keyword.control.include.luar" },
        "2": { "name": "punctuation.section.parens.begin.luar" },
        "3": { "name": "string.quoted.other.luar" },
        "4": { "name": "punctuation.section.parens.end.luar" }
      }
    },
    "type-annotation": {
      "comment": "Primitive types following a Luar type annotation colon",
      "match": "(:)([ \\t]*)(number|string|boolean|nil|table|function|any|unknown)\\b",
      "captures": {
        "1": { "name": "punctuation.separator.annotation.luar" },
        "3": { "name": "support.type.primitive.luar" }
      }
    },
    "import-decl": {
      "comment": "type-only module import",
      "match": "\\b(import)\\b[ \\t]+(type)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?:[ \\t]+(from)\\b)?",
      "captures": {
        "1": { "name": "keyword.control.import.luar" },
        "2": { "name": "storage.modifier.type.luar" },
        "3": { "name": "entity.name.namespace.luar" },
        "4": { "name": "keyword.control.import.luar" }
      }
    },
    "declare-decl": {
      "comment": "ambient declaration",
      "match": "\\b(declare)\\b(?:[ \\t]+(global)\\b)?(?:[ \\t]+(?!class\\b|function\\b)([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.control.declare.luar" },
        "2": { "name": "storage.modifier.global.luar" },
        "3": { "name": "variable.other.readwrite.luar" }
      }
    },
    "type-alias": {
      "comment": "[export] type Name = ...",
      "match": "(?:\\b(export)[ \\t]+)?\\b(type)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*=[^=])",
      "captures": {
        "1": { "name": "keyword.luar" },
        "2": { "name": "keyword.luar" },
        "3": { "name": "entity.name.type.alias.luar" }
      }
    },
    "template-header": {
      "comment": "template <T, U>: type parameters of the next declaration",
      "match": "\\b(template)\\b[ \\t]*(<)([^>\\n]*)(>)",
      "captures": {
        "1": { "name": "keyword.luar" },
        "2": { "name": "punctuation.definition.typeparameters.begin.luar" },
        "3": { "patterns": [ { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.type.parameter.luar" } ] },
        "4": { "name": "punctuation.definition.typeparameters.end.luar" }
      }
    },
    "cast-operator": {
      "comment": "expr :: Type (a label ::name:: is handled by #label)",
      "match": "::(?![ \\t]*[A-Za-z_][A-Za-z0-9_]*[ \\t]*::)",
      "name": "keyword.operator.cast.luar"
    },
    "type-operators": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.luar" },
        { "match": "\\|", "name": "keyword.operator.type.union.luar" }
      ]
    },
    "builtin": {
      "comment": "standard library names; the compiler's semantic tokens take over when available",
      "patterns": [
        {
          "match": "(?<![.:\\w])\\b(assert|collectgarbage|dofile|error|gcinfo|getfenv|getmetatable|ipairs|load|loadfile|newproxy|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setfenv|setmetatable|tonumber|tostring|type|typeof|warn|xpcall)\\b(?=[ \\t]*[(\"'{`])",
          "name": "support.function.builtin.luar"
        },
        {
          "match": "(?<![.:\\w])\\b(bit32|buffer|coroutine|debug|io|math|os|package|string|table|task|utf8)\\b(?=[ \\t]*\\.)",
          "name": "support.class.builtin.luar"
        }
      ]
    },
    "template-expression": {
      "comment": "the expression inside {} of a template string",
      "patterns": [
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#cast-operator" },
        { "include": "#builtin" },
        { "include": "#keyword" },
        { "include": "#constant" },
        { "match": "(?<=[.:])[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other.property.luar" },
        { "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b", "name": "variable.other.readwrite.luar" }
      ]
    },
    "binding-operator": {
      "comment": "condition-only local binding operator",
      "match": ":=",
      "name": "keyword.operator.binding.luar"
    },
    "function-decl": {
      "patterns": [
        {
          "comment": "function operator<op>",
          "match": "\\b(function)\\b[ \\t]+(operator)\\b",
          "captures": {
            "1": { "name": "keyword.luar" },
            "2": { "name": "keyword.luar" }
          }
        },
        {
          "comment": "function [Class.]name",
          "match": "\\b(function)\\b(?:[ \\t]+(?:[A-Za-z_][A-Za-z0-9_]*\\.)?([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.luar" },
            "2": { "name": "entity.name.function.luar" }
          }
        }
      ]
    },
    "friend-decl": {
      "comment": "contextual friend class X: friend is a keyword only before 'class'",
      "match": "\\b(friend)\\b(?=[ \\t]+class\\b)",
      "captures": {
        "1": { "name": "keyword.luar" }
      }
    },
    "class-decl": {
      "comment": "class Name ...",
      "match": "\\b(class)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.luar" },
        "2": { "name": "entity.name.type.luar" }
      }
    },
    "label": {
      "patterns": [
        {
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "punctuation.definition.label.begin.luar" },
            "2": { "name": "entity.name.label.luar" },
            "3": { "name": "punctuation.definition.label.end.luar" }
          }
        },
        {
          "match": "\\b(goto)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.goto.luar" },
            "2": { "name": "variable.other.label.luar" }
          }
        }
      ]
    },
    "keyword": {
      "name": "keyword.luar",
      "match": "\\b(is|public|private|static|abstract|override|final|super|operator|end|if|then|else|elseif|while|for|do|repeat|until|in|break|continue|goto|return|local|self|and|or|not|import|declare|global)\\b"
    },
    "constant": {
      "name": "constant.language.luar",
      "match": "\\b(true|false|nil)\\b"
    }
  }
}
