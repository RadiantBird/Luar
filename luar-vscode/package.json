{
  "name": "luar-language",
  "displayName": "Luar Language Support",
  "description": "Syntax highlighting, snippets, and language server for the Luar programming language",
  "version": "0.1.0",
  "publisher": "luar",
  "icon": "images/source.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "luar",
    "luau",
    "lua",
    "oop"
  ],
  "activationEvents": [
    "onLanguage:luar",
    "onLanguage:luard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Luar",
      "properties": {
        "luar.compiler.path": {
          "type": "string",
          "default": "luar",
          "description": "Path to the Rust Luar compiler used for semantic diagnostics."
        },
        "luar.target": {
          "type": "string",
          "enum": ["luau", "lua54"],
          "default": "luau",
          "description": "Compilation target used for target-compatibility diagnostics."
        }
      }
    },
    "languages": [
      {
        "id": "luar",
        "aliases": ["Luar", "luar"],
        "extensions": [".luar"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/source.png",
          "dark": "./images/source.png"
        }
      },
      {
        "id": "luard",
        "aliases": ["Luar Definition", "luard"],
        "extensions": [".luard"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/definition.png",
          "dark": "./images/definition.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "luar",
        "scopeName": "source.luar",
        "path": "./syntaxes/luar.tmLanguage.json"
      },
      {
        "language": "luard",
        "scopeName": "source.luar",
        "path": "./syntaxes/luar.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "luar",
        "path": "./snippets/luar.json"
      },
      {
        "language": "luard",
        "path": "./snippets/luar.json"
      }
    ],
    "configurationDefaults": {
      "[luar]": {
        "editor.minimap.enabled": false
      },
      "[luard]": {
        "editor.minimap.enabled": false
      }
    }
  },
  "scripts": {
    "build": "node build.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "watch": "node build.js --watch",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.0"
  }
}
